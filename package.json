{
  "name": "road-to-solution-architect",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:fixture": "node scripts/build-fixture.ts",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.ts",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content && npm run audit",
    "perf:bundle": "node scripts/check-budget.ts dist",
    "e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
